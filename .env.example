# Αντέγραψέ το σε .env και βάλε δικές σου τιμές πριν κάνεις `docker compose up`
# ΜΗΝ κάνεις commit το .env (είναι ήδη στο .gitignore)

# Postgres (χρησιμοποιείται από το api για users)
POSTGRES_USER=boxy_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=boxy_db

# InfluxDB (time-series data από telegraf/mqtt)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change_me_too
INFLUX_ORG=boxy
INFLUX_BUCKET=vehicle_data
INFLUX_TOKEN=dev-only-token-change-me

# API (FastAPI)
JWT_SECRET_KEY=change_me_random_string_2